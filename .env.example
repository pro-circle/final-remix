# Forge API keys - paste your Groq keys below (gsk_...), one per line.
# Up to five keys; Forge rotates across them automatically.
# Environment variables (GROQ_API_KEY ...) still win over this file.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Optional Gemini keys (Google AI Studio) - up to five.
# Forge schedules every request across Groq and Gemini by free TPM/RPM,
# so adding Gemini keys simply adds capacity. Groq-only setups are unchanged.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
